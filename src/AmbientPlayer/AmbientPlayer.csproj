<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AmbientPlayer</RootNamespace>
    <AssemblyName>AmbientPlayer</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Deliberately NOT set here: RuntimeIdentifier / SelfContained. Setting
         those unconditionally would make ordinary `dotnet build`/`dotnet run`
         behave like a self-contained RID-specific build, which build/run do
         not reliably produce a complete runtime layout for (only `publish`
         does) - the exe ends up missing native runtime files next to it and
         fails to launch. Pass them on the publish command line instead (see
         README "Publish a single-file executable"); these two properties are
         inert until a RID is supplied there. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Product>Ambient Now Playing</Product>
    <AssemblyTitle>Ambient Now Playing</AssemblyTitle>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows.Media.Control (SMTC) and Windows.Storage.Streams projections
         come from the Windows SDK metadata implied by the -windows10.0.19041.0
         TargetFramework suffix - no CsWinRT package reference needed. -->
  </ItemGroup>

</Project>
