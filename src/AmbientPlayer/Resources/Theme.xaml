<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Inter, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="TitleBrush" Color="White" />
    <SolidColorBrush x:Key="SubtitleBrush" Color="White" Opacity="0.7" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="White" Opacity="0.3" />
    <SolidColorBrush x:Key="ProgressFillBrush" Color="White" />
    <SolidColorBrush x:Key="TransportBrush" Color="White" />
    <SolidColorBrush x:Key="TransportDisabledBrush" Color="White" Opacity="0.25" />
    <SolidColorBrush x:Key="UtilityBrush" Color="White" Opacity="0.65" />

    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TransportBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TransportDisabledBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Smaller, dimmer secondary controls (volume, more, comments) that sit
         either side of the main transport row without competing with it. -->
    <Style x:Key="UtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource UtilityBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="8" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
