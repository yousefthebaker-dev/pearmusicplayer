<Window x:Class="AmbientPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:AmbientPlayer.Rendering"
        Title="Ambient Now Playing"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        Topmost="False"
        Background="Black"
        SizeChanged="OnWindowSizeChanged"
        KeyDown="OnWindowKeyDown"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed">

    <Grid x:Name="RootGrid">

        <rendering:MeshGradientBackground x:Name="MeshBackground" />

        <!-- Sits slightly above true centre: the top spacer gets less of the
             leftover space than the bottom spacer. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.45*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0.55*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Grid x:Name="ArtworkShadowHost" HorizontalAlignment="Center">

                    <!-- Two layers so a track change can crossfade between them
                         (400ms) instead of popping. Rounded corners come from
                         the Border itself - no clip geometry needed. -->
                    <Border x:Name="ArtworkLayerA" CornerRadius="6" Opacity="1" />
                    <Border x:Name="ArtworkLayerB" CornerRadius="6" Opacity="0" />
                </Grid>

                <TextBlock x:Name="TitleText"
                           Text="—"
                           FontFamily="{StaticResource DisplayFont}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TitleBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,28,0,0" />

                <TextBlock x:Name="SubtitleText"
                           Text=" "
                           FontFamily="{StaticResource BodyFont}"
                           Foreground="{StaticResource SubtitleBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />

                <Grid x:Name="ProgressRow" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ElapsedText"
                               Grid.Column="0"
                               Text="0:00"
                               FontFamily="{StaticResource BodyFont}"
                               Foreground="{StaticResource SubtitleBrush}"
                               VerticalAlignment="Center" />

                    <Border x:Name="ProgressTrack"
                            Grid.Column="1"
                            Height="4"
                            Margin="14,0"
                            CornerRadius="2"
                            Background="{StaticResource ProgressTrackBrush}"
                            SizeChanged="OnProgressTrackSizeChanged">
                        <Border x:Name="ProgressFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="2"
                                Background="{StaticResource ProgressFillBrush}" />
                    </Border>

                    <TextBlock x:Name="RemainingText"
                               Grid.Column="2"
                               Text="-0:00"
                               FontFamily="{StaticResource BodyFont}"
                               Foreground="{StaticResource SubtitleBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Three zones (left utilities | transport | right utility) in a
                     fixed-width row so the transport controls stay centred
                     regardless of the side icon counts being unequal. -->
                <Grid x:Name="TransportRow" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="VolumeButton" Style="{StaticResource UtilityButtonStyle}">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Data="M1,9 L1,15 L6,15 L12,20 L12,4 L6,9 Z" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource UtilityButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="3.5" Height="3.5" Margin="1,0"
                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                <Ellipse Width="3.5" Height="3.5" Margin="1,0"
                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                <Ellipse Width="3.5" Height="3.5" Margin="1,0"
                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevButton"
                                Style="{StaticResource TransportButtonStyle}"
                                Click="OnPreviousClick">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Data="M12,4 L4,12 L12,20 Z M20,4 L12,12 L20,20 Z" />
                        </Button>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource TransportButtonStyle}"
                                Click="OnPlayPauseClick">
                            <Path x:Name="PlayPauseIcon" Width="22" Height="22" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Data="M5,3 L19,12 L5,21 Z" />
                        </Button>

                        <Button x:Name="NextButton"
                                Style="{StaticResource TransportButtonStyle}"
                                Click="OnNextClick">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Data="M4,4 L12,12 L4,20 Z M12,4 L20,12 L12,20 Z" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CommentButton" Style="{StaticResource UtilityButtonStyle}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4"
                                  Data="M2,3 H18 A2,2 0 0 1 20,5 V13 A2,2 0 0 1 18,15 H9 L4,19 V15 H2 A2,2 0 0 1 0,13 V5 A2,2 0 0 1 2,3 Z" />
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
